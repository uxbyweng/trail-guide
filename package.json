{
    "name": "trail-guide",
    "version": "1.0.0",
    "description": "A small hiking trail directory with a server-rendered site, an admin panel and a JSON API.",
    "private": true,
    "scripts": {
        "dev": "bun --watch --check src/app.ts",
        "start": "bun src/app.ts",
        "typecheck": "tsc --noEmit",
        "db:seed": "bun src/db/seed.ts"
    },
    "type": "module",
    "dependencies": {
        "express": "^5.2.1",
        "nunjucks": "^3.2.4",
        "sanitize-html": "^2.18.1"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "@types/express": "^5.0.6",
        "@types/node": "^24.10.1",
        "@types/nunjucks": "^3.2.6",
        "@types/sanitize-html": "^2.16.2",
        "typescript": "^6.0.3"
    }
}
